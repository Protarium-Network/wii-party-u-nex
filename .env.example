# Wii Party U NEX server configuration.
#
# The two binaries (wpu-token, wpu-nex) MUST share the same values for
# PN_WPU_NEX_TOKEN_AES_KEY and PN_WPU_NEX_PASSWORD_SECRET - they independently
# derive the same token and kerberos password from them.

# --- Shared secrets (identical in both processes) ---
# 64 hex chars = AES-256 key sealing the NEX login token
PN_WPU_NEX_TOKEN_AES_KEY=
# >=32 bytes as hex; HMAC secret the per-PID NEX password is derived from
PN_WPU_NEX_PASSWORD_SECRET=

# --- wpu-nex (PRUDP servers) ---
PN_WPU_AUTH_PORT=27000
PN_WPU_SECURE_PORT=27001
# Host the console is told to reach the secure server on. Set to a real
# hostname/IP for a non-local deployment.
PN_WPU_SECURE_HOST=localhost

# --- wpu-token (account token issuer) ---
PN_WPU_TOKEN_LISTEN=127.0.0.1:8104
# Everything except Wii Party U's own nex_token / service_token is proxied here.
PN_ACCOUNT_UPSTREAM=https://account.pretendo.cc
# Wii U mTLS client cert/key for calling the upstream account API. Leave both
# empty if the upstream does not require client authentication.
PN_ACCOUNT_CLIENT_CERT=
PN_ACCOUNT_CLIENT_KEY=
